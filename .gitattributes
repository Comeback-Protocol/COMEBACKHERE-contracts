# Auto detect text files and normalize line endings to LF
* text=auto

# Rust
*.rs text eol=lf
Cargo.toml text eol=lf
Cargo.lock text eol=lf

# Documentation
*.md text eol=lf
*.mdx text eol=lf
README* text eol=lf
LICENSE* text eol=lf
CHANGELOG* text eol=lf
ARCHITECTURE* text eol=lf

# Web/Config
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.pre-commit-config.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary
*.db binary
